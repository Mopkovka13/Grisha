grishaksh.ru, www.grishaksh.ru {
	# Сертификат Let's Encrypt выпускается и продлевается автоматически.
	# Нужны оба порта снаружи: 80 (ACME-челлендж HTTP-01 и редирект на https)
	# и 443. Проброс на роутере должен вести 80->80 и 443->443, то есть в Caddy,
	# а не напрямую в приложение на 8080.
	reverse_proxy app:8080
}
